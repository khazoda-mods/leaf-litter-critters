{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "icon": "${icon}",
  "environment": "${environment}",
  "mixins": [
    "${mixins}"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "khazodacore": ">=${khazodacore}",
    "fabric-api-base": "*",
    "fabric-resource-loader-v1": "*",
    "minecraft": "${fabric_minecraft}",
    "java": ">=${java}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord}"
      }
    },
    "catalogue": {
      "banner": "${banner}",
      "background": "${background}"
    }
  }
}
